graph LR
    verify["Verify\nstep verify"] -->|"signature, deadline, graph valid"| read-state["Read State\nstep read-n"]
    verify -->|"bad signature, expired, wrong graph"| refused["Refused\noutcome refused"]
    read-state -->|"missing: the paper is read"| parse-paper["Parse Paper\nstep parse-paper-n"]
    read-state -->|"draft: shared as sealed"| store["Store\nstep store-n"]
    read-state -->|"stored: minted at once"| mint["Mint\nstep mint-n"]
    read-state -->|"minted: done"| done["Published\nTarget KA minted"]
    parse-paper -->|"title, abstract, opening (first attempt only)"| check-field["Check Field\nstep check-field-n"]
    parse-paper -->|"Target KA triples, field already checked"| store
    parse-paper -->|"not a PDF, too large, unparseable, no title, unreadable, no text"| refused
    check-field -->|"in the field, or no answer twice"| store
    check-field -->|"outside the field"| refused
    store -->|"stored on the node"| mint
    mint -->|"not seen within 10 s"| poll["Poll\nsteps wait-n-k, poll-n-k"]
    mint -->|"minted"| done
    poll -->|"minted"| done
    poll -.->|"not seen after 10 minutes: mint again"| mint
