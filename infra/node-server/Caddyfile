# The DKG node server's only public entry (docs/node-host.md → 7. Caddy and the
# credentials), installed as /etc/caddy/Caddyfile. Each environment's credential opens both
# sites (ADR 0039); a credential left empty opens nothing. Every secret comes from
# /etc/caddy/verisci.env, which caddy.service reads (caddy-env.conf here).

(credential) {
	@credential expression `
		("{$VERISCI_LOCAL_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$VERISCI_LOCAL_TOKEN}")
		|| ("{$VERISCI_STAGING_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$VERISCI_STAGING_TOKEN}")
		|| ("{$VERISCI_PRODUCTION_TOKEN}" != "" && {http.request.header.Authorization} == "Bearer {$VERISCI_PRODUCTION_TOKEN}")
	`
}

# The DKG daemon's API. Every route but the health check needs a credential, and the daemon
# gets its admin token instead. The health check is open and carries no token at all: Caddy
# matches the cleaned-up path but forwards the path as sent, and the daemon answers
# /api/status without one.
verisci-dkg.duckdns.org {
	import credential
	@status path /api/status
	handle @status {
		reverse_proxy 127.0.0.1:9200 {
			header_up -Authorization
		}
	}
	handle @credential {
		reverse_proxy 127.0.0.1:9200 {
			header_up Authorization "Bearer {$DKG_ADMIN_TOKEN}"
		}
	}
	handle {
		respond 401
	}
}

# GROBID, which takes no credential of its own: Caddy checks the environment's and drops it.
verisci-grobid.duckdns.org {
	import credential
	handle @credential {
		reverse_proxy 127.0.0.1:8070 {
			header_up -Authorization
		}
	}
	handle {
		respond 401
	}
}
