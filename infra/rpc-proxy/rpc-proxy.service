# systemd unit for the RPC proxy on the DKG node server (README.md here; docs/node-host.md).
# Install: copy src/ to /home/ubuntu/rpc-proxy/src and this file to /etc/systemd/system/, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now rpc-proxy
# The env file holds UPSTREAM_RPC (Alchemy RPC's URL, with its key) and is readable by ubuntu only.
# The DKG daemon's unit (infra/node-server/dkg.service) starts after this one.
[Unit]
Description=JSON-RPC proxy for the DKG daemon
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/rpc-proxy
EnvironmentFile=/home/ubuntu/rpc-proxy/env
ExecStart=/usr/bin/node /home/ubuntu/rpc-proxy/src/main.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
